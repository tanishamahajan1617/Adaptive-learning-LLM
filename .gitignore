# DATA
# ============================================================

# Ignore everything inside raw data
data/raw/*
data/raw/**/*.pdf
data/raw/**/*.PDF

# Keep raw folder in GitHub
!data/raw/.gitkeep


# Ignore processed/generated data
data/processed/*

# Keep processed folder in GitHub
!data/processed/.gitkeep


# Allow sample data folder
!data/sample/
!data/sample/**


